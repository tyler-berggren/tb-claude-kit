{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sqlite3 cowork/brain/BRAIN.db \"UPDATE sessions SET ended_at = strftime('%Y-%m-%dT%H:%M:%S', 'now', 'localtime') WHERE pid = $$ AND ended_at IS NULL;\"",
            "async": true
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch"
    ]
  }
}
