# Credentials via 1Password — op:// references resolved at runtime by `op run`
# Copy to .env and fill in your vault/item paths:
#
#   cp .env.example .env
#
# Usage:
#   op run --env-file=.env -- <command>
#
# See cowork/setup/1password-setup.md for full setup guide.

# Example: Cloud provider
# CLOUDFLARE_API_TOKEN=op://Vault Name/Cloudflare/token
# AWS_ACCESS_KEY_ID=op://Vault Name/AWS/access_key_id
# AWS_SECRET_ACCESS_KEY=op://Vault Name/AWS/secret_access_key

# Example: Third-party services
# STRIPE_SECRET_KEY=op://Vault Name/Stripe/secret_key
# GITHUB_TOKEN=op://Vault Name/GitHub/token
# DATABASE_URL=op://Vault Name/Database/connection_string
