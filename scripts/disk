#!/usr/bin/env -S python3 -I
"""disk — this Mac's drives, as /disk sees them.

  disk drives                 every drive a user would put files on (JSON)
  disk status                 the configured drives: mounted or not, free space against each floor
  disk check                  one line when a drive with a floor is below it, else nothing (session-start hook)
  disk config                 print the config path and its contents
  disk set-drive <uuid> [--label L] [--role hot|warm|archive] [--floor GB] [--attached yes|no]
  disk unset-drive <uuid>
  disk set <key> <json-value> set a top-level config key (projectRoots, warmAfterDays, ...)
  disk report [--json]        measure every drive: known items with what made them, unknown big folders,
                              worktrees; ranked recommendations. Changes nothing. Cached for `check`.

Drives are keyed by volume UUID, never by name: names change and collide ("Untitled", "Backup").
The config is per machine and lives outside any repo:
  $CLAUDE_KIT_DISK_CONFIG, else ~/.config/claude-kit/disk.json
A drive in the config that isn't mounted is reported as such and skipped, never an error.
"""
import json
import os
import plistlib
import shutil
import subprocess
import sys

CONFIG = os.environ.get("CLAUDE_KIT_DISK_CONFIG") or os.path.expanduser("~/.config/claude-kit/disk.json")
DATA_MOUNT = "/System/Volumes/Data"  # the internal volume that holds home folders on macOS 10.15+
GB = 1024 ** 3

DEFAULTS = {
    "drives": [],
    "projectRoots": ["~/dev"],
    "warmAfterDays": 60,
    "coldAfterDays": 365,
    "archiveDir": None,      # default: <first archive drive, else first warm drive>/disk-archive
    "worktreeDir": None,     # default: <first always-attached warm drive>/worktrees
    "knownItems": [],        # user additions to the skill's known-items.json
    "worktreeKeep": ["slot-*", "pool-*"],  # worktree names never swept (reusable pools)
}


def load_config():
    try:
        with open(CONFIG) as f:
            cfg = json.load(f)
    except FileNotFoundError:
        return None
    for k, v in DEFAULTS.items():
        cfg.setdefault(k, v)
    return cfg


def save_config(cfg):
    # Write through a symlink, never over it: the config is often linked in from a private config
    # repo (scripts/kit-config), and replacing the link would cut it off from that repo.
    target = os.path.realpath(CONFIG)
    os.makedirs(os.path.dirname(target), exist_ok=True)
    tmp = target + ".tmp"
    with open(tmp, "w") as f:
        json.dump(cfg, f, indent=2)
        f.write("\n")
    os.replace(tmp, target)


def mounts():
    """Mount points a user would store files on: the internal data volume and /Volumes/*."""
    out = subprocess.run(["/sbin/mount"], capture_output=True, text=True).stdout
    found = []
    for line in out.splitlines():
        if " on " not in line or "(" not in line:
            continue
        dev, rest = line.split(" on ", 1)
        point, opts = rest.rsplit(" (", 1)
        opts = opts.rstrip(")").split(", ")
        if not dev.startswith("/dev/"):
            continue  # network shares, devfs, autofs
        if point == DATA_MOUNT or (point.startswith("/Volumes/") and "nobrowse" not in opts and "read-only" not in opts):
            found.append(point)
    return found


def info(point):
    raw = subprocess.run(["/usr/sbin/diskutil", "info", "-plist", point], capture_output=True).stdout
    try:
        return plistlib.loads(raw)
    except Exception:
        return {}


def drive(point):
    d = info(point)
    usage = shutil.disk_usage(point)
    # APFS volumes share their container's space, so the container's free space is the real number.
    free = d.get("APFSContainerFree") or usage.free
    internal = bool(d.get("Internal"))
    label = d.get("VolumeName") or os.path.basename(point)
    if point == DATA_MOUNT:
        label = "Macintosh HD" if label == "Data" else label
    return {
        "uuid": d.get("VolumeUUID") or d.get("DiskUUID"),
        "label": label,
        "mount": point,
        "internal": internal,
        "filesystem": d.get("FilesystemType"),
        "bus": d.get("BusProtocol"),
        "ssd": d.get("SolidState"),
        "totalGB": round((d.get("TotalSize") or usage.total) / GB, 1),
        "freeGB": round(free / GB, 1),
    }


def all_drives():
    return [drive(p) for p in mounts()]


def status_rows(cfg):
    live = {d["uuid"]: d for d in all_drives()}
    rows = []
    for c in (cfg or {}).get("drives", []):
        d = live.pop(c["uuid"], None)
        row = dict(c)
        row["mounted"] = d is not None
        if d:
            row.update(mount=d["mount"], freeGB=d["freeGB"], totalGB=d["totalGB"], internal=d["internal"])
            floor = c.get("floorGB")
            row["belowFloor"] = floor is not None and d["freeGB"] < floor
        rows.append(row)
    for d in live.values():
        d["configured"] = False
        rows.append(d)
    return rows


def cmd_status():
    cfg = load_config()
    if cfg is None:
        print(f"No config at {CONFIG}. Run /disk setup.", file=sys.stderr)
    print(json.dumps({"config": CONFIG, "drives": status_rows(cfg)}, indent=2))


def cmd_check():
    """Fast and silent unless something is wrong. No config means nothing to check."""
    cfg = load_config()
    if not cfg:
        return
    for c in cfg.get("drives", []):
        floor = c.get("floorGB")
        mount = c.get("lastMount")
        if floor is None or not mount or not os.path.isdir(mount):
            continue
        try:
            free = shutil.disk_usage(mount).free / GB
        except OSError:
            continue
        if free < floor:
            top = top_consumer() if c.get("internal") else None
            hint = f" Biggest win from the last report: {top['name']}, {top['gb']:.0f} GB." if top else ""
            print(f"Disk: {c.get('label', mount)} has {free:.1f} GB free, under its {floor:.0f} GB floor.{hint} Run /disk to see what to clear or move.")


def cmd_set_drive(args):
    if not args:
        sys.exit("usage: disk set-drive <uuid> [--label L] [--role hot|warm|archive] [--floor GB] [--attached yes|no]")
    uuid, opts = args[0], args[1:]
    cfg = load_config() or dict(DEFAULTS, drives=[])
    live = {d["uuid"]: d for d in all_drives()}
    entry = next((c for c in cfg["drives"] if c["uuid"] == uuid), None)
    if entry is None:
        if uuid not in live:
            sys.exit(f"No mounted drive has UUID {uuid}. `disk drives` lists them.")
        entry = {"uuid": uuid, "label": live[uuid]["label"], "internal": live[uuid]["internal"]}
        cfg["drives"].append(entry)
    it = iter(opts)
    for flag in it:
        val = next(it, None)
        if val is None:
            sys.exit(f"{flag} needs a value")
        if flag == "--label":
            entry["label"] = val
        elif flag == "--role":
            if val not in ("hot", "warm", "archive"):
                sys.exit("role is hot, warm or archive")
            entry["role"] = val
        elif flag == "--floor":
            entry["floorGB"] = float(val)
        elif flag == "--attached":
            entry["alwaysAttached"] = val.lower() in ("yes", "true", "1")
        else:
            sys.exit(f"unknown flag {flag}")
    if uuid in live:
        entry["lastMount"] = live[uuid]["mount"]  # lets `check` stay fast: no diskutil call
    if entry.get("internal"):
        entry.setdefault("alwaysAttached", True)
    save_config(cfg)
    print(json.dumps(entry, indent=2))


def cmd_unset_drive(args):
    cfg = load_config()
    if not cfg or not args:
        sys.exit("usage: disk unset-drive <uuid>")
    cfg["drives"] = [c for c in cfg["drives"] if c["uuid"] != args[0]]
    save_config(cfg)


def cmd_set(args):
    if len(args) != 2 or args[0] not in DEFAULTS or args[0] == "drives":
        sys.exit("usage: disk set <key> <json-value>; keys: " + ", ".join(k for k in DEFAULTS if k != "drives"))
    cfg = load_config() or dict(DEFAULTS, drives=[])
    cfg[args[0]] = json.loads(args[1])
    save_config(cfg)


# ---------------------------------------------------------------- report

HERE = os.path.dirname(os.path.realpath(__file__))
KNOWN = os.path.join(HERE, "..", ".claude", "skills", "disk", "known-items.json")
REPORT_CACHE = os.path.expanduser("~/.cache/claude-kit/disk-report.json")
MIN_UNKNOWN_GB = 1.0
# Folders whose children are listed one by one, so an unknown big item is still named.
SCAN_PARENTS = ["~/Library/Caches", "~/Library/Application Support", "~/Library/Containers",
                "~/Library/Group Containers", "~/.cache", "~/Library/Developer"]


def du_kb(path, timeout=300):
    """(kb, error). du counts hard links once per call and never follows symlinks."""
    try:
        r = subprocess.run(["/usr/bin/du", "-sk", path], capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return None, "timed out"
    kb = int(r.stdout.split()[0]) if r.stdout.strip() else None
    err = None
    if "Operation not permitted" in r.stderr:
        err = "partly unreadable: give your terminal Full Disk Access to measure it"
    return kb, err


def drive_of(path, drives):
    try:
        dev = os.stat(path).st_dev
    except OSError:
        return None
    for d in drives:
        try:
            if os.stat(d["mount"]).st_dev == dev:
                return d
        except OSError:
            pass
    return None


def load_known(cfg):
    items = {i["id"]: i for i in json.load(open(KNOWN))["items"]}
    for i in (cfg or {}).get("knownItems", []):
        items[i["id"]] = i
    return list(items.values())


def warm_mount(cfg, drives):
    live = {d["uuid"]: d for d in drives}
    for c in (cfg or {}).get("drives", []):
        if c.get("role") == "warm" and c.get("alwaysAttached") and c["uuid"] in live:
            return live[c["uuid"]]["mount"]
    return None


def cmd_report(args):
    from concurrent.futures import ThreadPoolExecutor
    import glob
    import time

    as_text = "--json" not in args
    cfg = load_config()
    drives = all_drives()
    conf = {c["uuid"]: c for c in (cfg or {}).get("drives", [])}
    for d in drives:
        c = conf.get(d["uuid"], {})
        d.update(role=c.get("role"), floorGB=c.get("floorGB"), alwaysAttached=c.get("alwaysAttached"))
    warm = warm_mount(cfg, drives)
    known = load_known(cfg)

    # Expand every known path; remember which real paths are claimed, so the unknown scan skips them.
    jobs, claimed = [], set()
    for item in known:
        for pat in item.get("paths", []):
            for p in glob.glob(os.path.expanduser(pat)):
                claimed.add(os.path.realpath(p))
                jobs.append((item, p))

    unknown_jobs = []
    for parent in SCAN_PARENTS:
        parent = os.path.expanduser(parent)
        try:
            names = os.listdir(parent)
        except OSError:
            continue
        for n in names:
            p = os.path.join(parent, n)
            rp = os.path.realpath(p)
            if os.path.islink(p) or rp in claimed or any(c.startswith(rp + "/") for c in claimed):
                continue
            unknown_jobs.append(p)

    with ThreadPoolExecutor(max_workers=8) as pool:
        sizes = list(pool.map(lambda j: du_kb(j[1]), jobs))
        usizes = list(pool.map(du_kb, unknown_jobs))

    found = {}
    for (item, p), (kb, err) in zip(jobs, sizes):
        if os.path.islink(p):
            target = os.path.realpath(p)
            d = drive_of(target, drives)
            f = found.setdefault(item["id"], dict(item, gb=0.0, places=[]))
            f["places"].append({"path": p, "movedTo": target, "drive": d["label"] if d else None})
            continue
        if not kb:
            continue
        d = drive_of(p, drives)
        f = found.setdefault(item["id"], dict(item, gb=0.0, places=[]))
        f["gb"] += kb / 1024 / 1024
        f["places"].append({"path": p, "gb": round(kb / 1024 / 1024, 2), "drive": d["label"] if d else None, **({"note": err} if err else {})})

    unknown = []
    for p, (kb, err) in zip(unknown_jobs, usizes):
        if kb and kb / 1024 / 1024 >= MIN_UNKNOWN_GB:
            d = drive_of(p, drives)
            unknown.append({"path": p, "gb": round(kb / 1024 / 1024, 2), "drive": d["label"] if d else None,
                            "creator": os.path.basename(p), **({"note": err} if err else {})})

    # Worktrees, through the shared sweep rules.
    sweep = os.path.join(HERE, "worktree-sweep")
    wt = []
    if os.access(sweep, os.X_OK):
        r = subprocess.run([sweep, "--json"], capture_output=True, text=True, timeout=600)
        try:
            wt = json.loads(r.stdout or "[]")
        except ValueError:
            wt = []
    wt_summary = {}
    for w in wt:
        s = wt_summary.setdefault(w["verdict"], {"count": 0, "gb": 0.0})
        s["count"] += 1
        s["gb"] = round(s["gb"] + w.get("gb", 0.0), 2)

    # Recommendations: what to do with each measured item, largest first.
    recs = []
    for f in found.values():
        gb = round(f["gb"], 2)
        if gb < 0.25:
            continue
        action = f.get("action", "report")
        how = None
        if action == "redirect":
            if warm and f.get("redirect", {}).get("how"):
                how = f["redirect"]["how"].replace("{warm}", warm)
            elif f.get("delete"):
                action, how = "delete", f["delete"]
            else:
                action = "report"
        elif action == "delete":
            how = f.get("delete")
        elif action == "move":
            how = (f.get("redirect") or {}).get("how", "move it to the warm drive" if warm else None)
        dlabels = sorted({p.get("drive") for p in f["places"] if p.get("drive")})
        recs.append({"id": f["id"], "name": f["name"], "gb": gb, "action": action, "how": how,
                     "drive": dlabels[0] if len(dlabels) == 1 else ", ".join(dlabels) or None,
                     "creator": f.get("creator"), "regenerates": f.get("regenerates"), "cost": f.get("cost"),
                     "places": f["places"]})
    by_drive = {}
    for w in wt:
        if w["verdict"] != "remove":
            continue
        d = drive_of(w["path"], drives) if os.path.exists(w["path"]) else None
        key = d["label"] if d else None
        b = by_drive.setdefault(key, {"count": 0, "gb": 0.0, "repos": set()})
        b["count"] += 1
        b["gb"] += w.get("gb", 0.0)
        b["repos"].add(w["repo"])
    for label, b in by_drive.items():
        if b["gb"] >= 0.25:
            recs.append({"id": "agent-worktrees", "name": f"{b['count']} finished worktree(s)", "gb": round(b["gb"], 2),
                         "drive": label, "action": "delete",
                         "how": "~/.claude-kit/scripts/worktree-sweep --apply " + " ".join(sorted(b["repos"])),
                         "creator": "Claude agents, /swarm, /plan, git worktree add", "regenerates": True})
    # The drive under the most pressure first (hot drives, then the least free space), then size.
    pressure = {d["label"]: (0 if d.get("role") == "hot" or d.get("internal") else 1, d["freeGB"]) for d in drives}
    recs.sort(key=lambda r: (pressure.get(r.get("drive"), (2, 0)), -r["gb"]))
    moved = [dict(id=f["id"], name=f["name"], places=f["places"]) for f in found.values()
             if any("movedTo" in p for p in f["places"])]

    report = {"generated": time.strftime("%Y-%m-%d %H:%M"), "drives": drives, "warmDrive": warm,
              "recommendations": recs, "unknown": sorted(unknown, key=lambda u: -u["gb"]),
              "alreadyMoved": moved, "worktrees": {"summary": wt_summary, "items": wt}}
    os.makedirs(os.path.dirname(REPORT_CACHE), exist_ok=True)
    with open(REPORT_CACHE, "w") as fh:
        json.dump(report, fh, indent=2)

    if not as_text:
        print(json.dumps(report, indent=2))
        return
    print(f"Disk report {report['generated']}")
    for d in drives:
        floor = f", floor {d['floorGB']:.0f} GB" if d.get("floorGB") is not None else ""
        flag = "  ← below floor" if d.get("floorGB") is not None and d["freeGB"] < d["floorGB"] else ""
        print(f"  {d['label']:<16} {d.get('role') or 'unconfigured':<12} {d['freeGB']:>7.1f} GB free of {d['totalGB']:.0f}{floor}{flag}")
    n, last = 0, object()
    for r in [r for r in recs if r["action"] != "report"]:
        if r.get("drive") != last:
            last = r.get("drive")
            print(f"\nOn {last or 'another drive'}, largest first:")
        n += 1
        print(f"  {n:>2}. {r['gb']:6.1f} GB  {r['name']} — {r['action']}: {r['how'] or '(by hand)'}")
        if r.get("cost"):
            print(f"               cost: {r['cost']}")
    rep = [r for r in recs if r["action"] == "report"]
    if rep:
        print("\nYours to judge (not touched):")
        for r in rep:
            print(f"      {r['gb']:6.1f} GB  {r['name']}" + (f" — {r['cost']}" if r.get("cost") else ""))
    if unknown:
        print("\nNot in the known list (≥ 1 GB):")
        for u in report["unknown"][:15]:
            print(f"      {u['gb']:6.1f} GB  {u['path']}" + (f"  ({u['note']})" if u.get("note") else ""))
    if wt_summary:
        print("\nWorktrees: " + ", ".join(f"{v['count']} {k} ({v['gb']:.1f} GB)" for k, v in wt_summary.items()))
    if moved:
        print("\nAlready moved off: " + ", ".join(m["name"] for m in moved))


def top_consumer():
    """The biggest recommendation in a report from the last 7 days, for the session-start line."""
    try:
        st = os.stat(REPORT_CACHE)
        import time
        if time.time() - st.st_mtime > 7 * 86400:
            return None
        recs = [r for r in json.load(open(REPORT_CACHE))["recommendations"] if r["action"] != "report"]
        return recs[0] if recs else None
    except (OSError, ValueError, KeyError):
        return None


def main():
    cmd, args = (sys.argv[1] if len(sys.argv) > 1 else "status"), sys.argv[2:]
    if cmd == "drives":
        print(json.dumps(all_drives(), indent=2))
    elif cmd == "status":
        cmd_status()
    elif cmd == "check":
        cmd_check()
    elif cmd == "config":
        print(CONFIG)
        cfg = load_config()
        print(json.dumps(cfg, indent=2) if cfg else "(none yet)")
    elif cmd == "set-drive":
        cmd_set_drive(args)
    elif cmd == "unset-drive":
        cmd_unset_drive(args)
    elif cmd == "set":
        cmd_set(args)
    elif cmd == "report":
        cmd_report(args)
    else:
        print(__doc__)
        sys.exit(0 if cmd in ("-h", "--help", "help") else 1)


if __name__ == "__main__":
    main()
