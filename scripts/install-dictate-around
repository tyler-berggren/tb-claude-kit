#!/bin/bash
# install-dictate-around — the kit's entry point for dictate-around, which ships with the kit in
# modules/dictate-around (also published on its own: https://github.com/tyler-berggren/dictate-around).
# Every option is passed through; see modules/dictate-around/README.md.
exec "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/modules/dictate-around/install.sh" "$@"
