#!/bin/bash
# oprun — run a command with this project's client secrets resolved from 1Password.
#
#   oprun -- <command> [args...]            resolve the .env chain, run the command
#   oprun get VAR                           print one variable from the .env chain, resolved if it is an op:// reference
#   oprun --env-file other.env -- <cmd>     one or more env files (repeatable)
#   oprun --vault <name> -- <cmd>           override the project's vault
#   oprun read op://<vault>/<item>/<field>  print one secret (avoid in agent sessions: it lands in the transcript)
#   oprun check                             confirm the token works and show which vault it sees
#   oprun op <op args...>                   any op command with the vault token (item create/edit/get/list)
#
# The .env chain: every .env from the repo root down to the working directory, nearest last, so a
# subproject's .env overrides the root's the way `source ../../.env; source ../.env` used to.
#
# Why this exists: every client has its own 1Password vault, and a service account's vault list
# cannot be changed after creation. So there is one read-only service account per client vault,
# its token lives in the macOS Keychain as "op-sa-<vault>", and the repo says which vault it
# belongs to (secrets.vault in .claude/kit.json). Nothing is exported globally — a token in
# ~/.zshenv silently overrides Touch ID for every op call, which is how the 2026-09-18 outage
# happened. See ~/.claude-kit README, "Secrets".
#
# Two traps this script is shaped around:
#   - On macOS 26 the service-account path can hang forever on a TCC dialog (op-js #216), and
#     macOS has no `timeout`. The preflight runs under a perl alarm so a hang fails in 20 s
#     instead of never; the real command then runs unbounded, because pipelines take hours.
#   - `op run` masks resolved values in output (good for transcripts) but corrupts protocols that
#     carry the value, such as MCP stdio. Pass --no-masking for those.

set -euo pipefail

usage() { sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
die() { echo "oprun: $*" >&2; exit 1; }

PREFLIGHT_SECS=20
vault="${OPRUN_VAULT:-}"
env_files=()
passthrough=()
mode="run"

# --- parse -------------------------------------------------------------------------------------
while [ $# -gt 0 ]; do
  case "$1" in
    --) shift; break ;;
    --vault) vault="$2"; shift 2 ;;
    --env-file) env_files+=("$2"); shift 2 ;;
    --no-masking) passthrough+=("--no-masking"); shift ;;
    read) mode="read"; shift; break ;;
    check) mode="check"; shift; break ;;
    op) mode="op"; shift; break ;;
    get) mode="get"; shift; break ;;
    -h|--help) usage ;;
    *) die "unknown argument: $1 (put the command after --)" ;;
  esac
done
[ "$mode" = "run" ] && [ $# -eq 0 ] && usage
[ "$mode" = "read" ] && [ $# -ne 1 ] && die "read takes exactly one op:// reference"
[ "$mode" = "op" ] && [ $# -eq 0 ] && die "op mode needs a command, e.g. oprun op item list --vault <vault>"
[ "$mode" = "get" ] && [ $# -ne 1 ] && die "get takes exactly one variable name"

# --- find the project root and its vault ------------------------------------------------------
root="$PWD"
while [ "$root" != "/" ] && [ ! -f "$root/.claude/kit.json" ]; do root="$(dirname "$root")"; done
if [ -z "$vault" ]; then
  [ -f "$root/.claude/kit.json" ] || die "no .claude/kit.json above $PWD and no --vault given"
  vault="$(jq -r '.secrets.vault // empty' "$root/.claude/kit.json")"
  [ -n "$vault" ] || die "$root/.claude/kit.json has no secrets.vault — add {\"secrets\": {\"vault\": \"<name>\"}}"
fi

# --- the .env chain: root/.env, then each directory down to $PWD --------------------------------
env_chain() {
  local rel="${PWD#"$root"}" dir="$root"
  [ -f "$dir/.env" ] && echo "$dir/.env"
  local IFS=/
  for part in ${rel#/}; do
    [ -n "$part" ] || continue
    dir="$dir/$part"
    [ -f "$dir/.env" ] && echo "$dir/.env"
  done
}

# --- token from the Keychain --------------------------------------------------------------------
token="$(security find-generic-password -a "$USER" -s "op-sa-$vault" -w 2>/dev/null || true)"
[ -n "$token" ] || die "no Keychain item op-sa-$vault — run: ~/.claude-kit/scripts/op-sa-bootstrap $vault"

# The token must reach op and nothing else. Never export it into the calling shell. (one env assignment on one exec)
bounded() { OP_SERVICE_ACCOUNT_TOKEN="$token" perl -e "alarm $PREFLIGHT_SECS; exec @ARGV" op "$@"; }

# --- preflight: does the service-account path answer at all? -------------------------------------
# `op whoami` is honest on the service-account path (it lies only on the desktop-app path).
if ! who="$(bounded whoami --format json 2>&1)"; then
  case "$who" in
    *"Service Account Deleted"*|*"401"*|*"403"*) die "the token for $vault is dead or revoked — re-run op-sa-bootstrap $vault. ($who)" ;;
    *) die "op did not answer within ${PREFLIGHT_SECS}s (see op-js #216 for the macOS 26 hang). Output: $who" ;;
  esac
fi

case "$mode" in
  check)
    echo "vault:   $vault"
    echo "account: $(echo "$who" | jq -r '.url // .account_uuid // "?"')"
    echo "service account: $(echo "$who" | jq -r '.service_account_type // "?"') $(echo "$who" | jq -r '.user_uuid // ""')"
    echo "vaults visible:"
    bounded vault list --format json | jq -r '.[] | "  - \(.name) (\(.id))"'
    ;;
  read)
    bounded read "$1"
    ;;
  get)
    # Nearest file wins. Values are read raw (quotes stripped) and resolved only if they are references.
    val=""; found="no"
    for f in $(env_chain); do
      line="$(grep -E "^$1=" "$f" | tail -1 || true)"
      [ -n "$line" ] && { val="${line#*=}"; found="yes"; }
    done
    [ "$found" = "yes" ] || die "$1 is not set in any .env between $root and $PWD"
    val="${val%\"}"; val="${val#\"}"
    case "$val" in op://*) bounded read "$val" ;; *) printf '%s\n' "$val" ;; esac
    ;;
  op)
    # Unbounded on purpose: the preflight proved the path answers, and a document upload can be slow.
    exec env OP_SERVICE_ACCOUNT_TOKEN="$token" op "$@"
    ;;
  run)
    if [ ${#env_files[@]} -eq 0 ]; then for f in $(env_chain); do env_files+=("$f"); done; fi
    # bash 3.2 (macOS) treats an empty array as unbound under set -u; the ${a[@]+"${a[@]}"} form is safe.
    args=()
    for f in ${env_files[@]+"${env_files[@]}"}; do args+=("--env-file=$f"); done
    exec env OP_SERVICE_ACCOUNT_TOKEN="$token" op run ${args[@]+"${args[@]}"} ${passthrough[@]+"${passthrough[@]}"} -- "$@"
    ;;
esac
