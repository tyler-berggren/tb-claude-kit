#!/bin/bash
# private-guard — a git pre-commit hook: refuse a commit whose added lines contain a private word.
#
#   private-guard <words-file>
#
# The words file is yours and private: one word or phrase per line, matched case-insensitively
# anywhere in an added line ('#' starts a comment). Typical entries: your drive names, client and
# project names, your email, your home path. `kit-config link` installs this as the kit checkout's
# pre-commit hook when your config repo's manifest names a words file ("guard"), so the list never
# lands in the public repo.
#
# Only staged ADDITIONS are checked: removing a private word is always allowed.
# A deliberate exception: git commit --no-verify.
set -u
WORDS="${1:-}"
[ -n "$WORDS" ] && [ -f "$WORDS" ] || exit 0          # no list on this machine: nothing to check

patterns=$(grep -v -E '^\s*(#|$)' "$WORDS")
[ -n "$patterns" ] || exit 0

hits=$(git diff --cached -U0 --no-color --no-ext-diff |
  awk '/^\+\+\+ /{f=substr($0,7); next} /^@@/{split($3,a,","); n=substr(a[1],2)+0; next}
       /^\+/{print f ":" n ": " substr($0,2); n++}' |
  grep -i -F -- "$patterns")

if [ -n "$hits" ]; then
  echo "private-guard: this commit adds private words (list: $WORDS):" >&2
  echo "$hits" | cut -c1-200 | head -20 | sed 's/^/  /' >&2
  echo "Replace them with generic names, or commit with --no-verify if this is deliberate." >&2
  exit 1
fi
exit 0
