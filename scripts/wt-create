#!/bin/bash
# wt-create — Claude Code WorktreeCreate hook: put worktrees on an always-attached external drive.
#
# Claude Code creates worktrees inside the repo (.claude/worktrees/<name>) and has no setting to
# move them; it also refuses a symlinked .claude/worktrees. A WorktreeCreate hook replaces its
# creation logic: Claude passes JSON on stdin ({"name": ..., "cwd": ...}) and uses the absolute
# path printed as the LAST stdout line. Everything else goes to stderr.
#
# Where: scripts/wt-path decides (worktreeDir in disk.json, else the always-attached warm drive,
# else the repo's .claude/worktrees, where Claude Code would put it), so nothing ever breaks.
#
# Registered by /disk setup in ~/.claude/settings.json, with wt-remove as WorktreeRemove.
set -euo pipefail

INPUT=$(cat)
NAME=$(jq -r '.name // empty' <<<"$INPUT")
CWD=$(jq -r '.cwd // empty' <<<"$INPUT")
[ -n "$NAME" ] || { echo "wt-create: no name in hook input" >&2; exit 1; }
REPO=$(git -C "${CWD:-$PWD}" rev-parse --show-toplevel)
# A worktree session's cwd may itself be a worktree: anchor on the main checkout.
REPO=$(git -C "$REPO" worktree list --porcelain | awk 'NR==1{print $2}')
# Where it goes is one rule shared with the kit's own worktrees: scripts/wt-path.
DIR=$("$(dirname "$(realpath "$0")")/wt-path" "$NAME" "$REPO")

BRANCH="worktree-$NAME"
if git -C "$REPO" worktree list --porcelain | grep -qx "worktree $DIR"; then
  echo "wt-create: reusing $DIR" >&2
else
  mkdir -p "$(dirname "$DIR")"
  if git -C "$REPO" show-ref --verify --quiet "refs/heads/$BRANCH"; then
    git -C "$REPO" worktree add "$DIR" "$BRANCH" >&2
  else
    git -C "$REPO" worktree add -b "$BRANCH" "$DIR" HEAD >&2
  fi
  # A hook replaces Claude Code's own logic, so .worktreeinclude (gitignored files to copy into
  # new worktrees, such as .env) is ours to honour.
  if [ -f "$REPO/.worktreeinclude" ]; then
    git -C "$REPO" ls-files -o -i --exclude-from=.worktreeinclude -z 2>/dev/null |
      (cd "$REPO" && xargs -0 -I{} rsync -R "{}" "$DIR/") >&2 || true
  fi
fi

echo "$DIR"
